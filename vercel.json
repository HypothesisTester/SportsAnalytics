{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "client/build",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
